// Reusable Vehicle Card component
const props = Astro.props;
const v = props.vehicle;
const locale = props.locale || "en";
const isEs = locale === "es";
const previewLabel = isEs ? "Vista previa" : "Preview";
const detailsLink = isEs ? "Ver detalles del vehículo" : "View vehicle details";

const FUEL_LABELS = {
  premium_gasoline: { en: "Premium Gasoline", es: "Gasolina premium" },
  electric: { en: "Electric", es: "Eléctrico" },
  plug_in_hybrid: { en: "Plug-in Hybrid", es: "Híbrido enchufable" },
  hybrid: { en: "Hybrid", es: "Híbrido" },
  gasoline: { en: "Gasoline", es: "Gasolina" },
  diesel: { en: "Diesel", es: "Diésel" },
};

function fuelLabel(fuelType) {
  return (FUEL_LABELS[fuelType] || {})[locale] ?? fuelType;
}

const fuelColor = (() => {
  const ft = v.fuel_type;
  if (ft === "electric") return "#059669";
  if (ft === "plug_in_hybrid" || ft === "hybrid") return "#EA5E2D";
  return "#8E8E90";
})();
---

<div class="group flex flex-col rounded-2xl border border-[var(--color-border)] bg-white shadow-sm transition-all duration-300 hover:border-[var(--color-brand-300)] hover:shadow-lg">
  <!-- Clickable image area -->
  <a href={isEs ? `/es/vehicles/${v.slug}/` : `/vehicles/${v.slug}/`} class="block overflow-hidden rounded-t-2xl">
    <div class="aspect-[4/3] bg-[var(--color-surface-light)]">
      {v.hero_image ? (
        <img
          src={v.hero_image}
          alt={`${v.name} — exterior photo`}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          width="600"
          height="450"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center">
          <p class="text-sm text-[var(--color-ink-tertiary)]">{isEs ? "Foto pendiente" : "Photo pending"}</p>
        </div>
      )}
    </div>
  </a>

  <!-- Card content -->
  <div class="flex flex-1 flex-col gap-2 p-5">
    <!-- Vehicle name + year + category -->
    <a href={isEs ? `/es/vehicles/${v.slug}/` : `/vehicles/${v.slug}/`} class="block">
      <h3 class="text-lg font-semibold leading-tight text-[var(--color-navy-900)] transition-colors group-hover:text-[var(--color-blue-500, #3B82F6)]">
        {v.name}
      </h3>
    </a>
    <p class="line-clamp-1 text-sm text-[var(--color-ink-secondary)]">
      {isEs ? (v.tagline_es || v.tagline_en) : v.tagline_en}
    </p>

    <!-- Capacity metadata row — SVG icons, accessible labels -->
    <dl class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
      <dt class="sr-only">Passenger capacity</dt>
      <dd class="flex items-center gap-1.5 text-[var(--color-ink-secondary)]">
        <!-- People / seats icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-[15px] w-[15px] shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
        <span>{v.passenger_capacity} {isEs ? "asientos" : "seats"}</span>
      </dd>
      <dt class="sr-only">Luggage capacity</dt>
      <dd class="flex items-center gap-1.5 text-[var(--color-ink-secondary)]">
        <!-- Suitcase / luggage icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-[15px] w-[15px] shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 00-7.5 0l-4.5 1.5a3 3 0 000 5.714l4.5 1.5a3.75 3.75 0 007.5 0l4.5-1.5a3 3 0 000-5.714l-4.5-1.5a3.75 3.75 0 00-7.5 0z" />
        </svg>
        <span>{v.luggage_large} {isEs ? "maleta(s)" : "bag(s)"}</span>
      </dd>
      <dt class="sr-only">Fuel type</dt>
      <dd class="flex items-center gap-1.5 text-[var(--color-ink-secondary)]">
        <!-- Fuel/energy icon — colored by fuel type -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-[15px] w-[15px] shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke={fuelColor} aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003.361 6.867zM15.362 5.214L18 9.6m-2.638-4.386L12 21" />
        </svg>
        <span>{fuelLabel(v.fuel_type)}</span>
      </dd>
    </dl>

    <!-- Preview badge -->
    {v.publication_status === "preview_only" && (
      <span class="inline-block w-fit rounded-full bg-[var(--color-warning)]/[.12] px-2.5 py-0.5 text-xs font-medium text-[var(--color-warning)]">
        {previewLabel}
      </span>
    )}

    <!-- Bottom section: CTA button + details link -->
    <div class="mt-auto pt-3">
      <a
        href={`/reserve/${v.slug}/`}
        class="mb-2 block w-full rounded-xl bg-[var(--color-brand)] px-4 py-2.5 text-center text-sm font-semibold text-white shadow-[0_2px_8px_-2px_rgba(49,75,110,.3)] transition-all duration-300 hover:bg-[var(--color-brand-400)] hover:-translate-y-0.5 hover:shadow-[0_6px_20px_-4px_rgba(49,75,110,.35)]"
      >
        {isEs ? "Ver disponibilidad y precio" : "Check availability & pricing"}
      </a>
      <a
        href={isEs ? `/es/vehicles/${v.slug}/` : `/vehicles/${v.slug}/`}
        class="block text-center text-sm font-medium text-[#3B82F6] underline-offset-2 transition-colors group-hover:underline"
      >
        {detailsLink} &rarr;
      </a>
    </div>
  </div>
</div>
