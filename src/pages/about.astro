---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/base/Header.astro";
import Footer from "../components/base/Footer.astro";
import { SITE } from "../config/site";
---

<BaseLayout
  title="About 305 Fleet — South Florida's Local Fleet Operator"
  description="305 Fleet is locally owned and operated by Turomina LLC. We serve MIA, FLL, and PBI with professionally maintained vehicles, contactless airport pickup, and direct English &amp; Spanish assistance."
>
  <Header />

  <main id="main-content" class="flex-1">
    <!-- ═══════════════════ HERO ═══════════════════ -->
    <section class="section-sm gradient-dark text-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <p class="text-accent font-semibold tracking-[0.12em] uppercase text-sm mb-4">About Us</p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-tight">South Florida's local fleet.</h1>
        <p class="mt-4 text-lg text-white/70 max-w-2xl leading-relaxed">
          A real operator. Real vehicles. Real accountability. We rent directly from a carefully selected fleet
          at three South Florida airports — MIA, FLL, and PBI — so you know exactly what you're getting.
        </p>
      </div>
    </section>

    <!-- ═══════════════════ OWNERSHIP ═══════════════════ -->
    <section class="section bg-surface">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-ink mb-6">Who we are</h2>
        <p class="text-ink-secondary leading-relaxed mb-4">
          305 Fleet is owned and operated by <strong class="text-ink">Turomina LLC</strong>, a South Florida-based company.
          We exist because renting a vehicle shouldn't mean choosing between impersonal national chains and unpredictable peer-to-peer platforms.
        </p>
        <p class="text-ink-secondary leading-relaxed mb-4">
          We know these airports, these roads, and this community. Every vehicle in our fleet is personally selected and inspected.
          Every rental is handled by our local team — not a remote call center. You can reach us directly whenever you need to.
        </p>
        <p class="text-ink-secondary leading-relaxed mb-8">
          Our philosophy is straightforward: maintain a small, excellent fleet. Present them professionally. Offer contactless pickup
          from designated airport parking. Set clear expectations from the start. Do one thing well.
        </p>


      </div>
    </section>

    <!-- ═══════════════════ WHAT WE OFFER (VALUE GRID) ═══════════════════ -->
    <section class="section bg-brand-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-ink text-center mb-4">What sets us apart</h2>
        <p class="text-ink-secondary text-center max-w-xl mx-auto mb-12">
          Six commitments that define every rental with 305 Fleet.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Value card 1 — Locally Owned -->
          <div class="bg-white rounded-2xl p-8 border border-border hover:border-brand-200 transition-colors">
            <svg class="w-8 h-8 text-accent mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <h3 class="text-lg font-semibold text-ink mb-2">Locally Owned &amp; Operated</h3>
            <p class="text-sm text-ink-secondary leading-relaxed">
              Turomina LLC is based right here in South Florida. We're not a faceless chain or offshore platform —
              we live, work, and depend on our reputation in this community.
            </p>
          </div>

          <!-- Value card 2 — Bilingual Support -->
          <div class="bg-white rounded-2xl p-8 border border-border hover:border-brand-200 transition-colors">
            <svg class="w-8 h-8 text-accent mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-10.5L16.5 9m0 0L21 13.5m0-4.5h-13.5" />
            </svg>
            <h3 class="text-lg font-semibold text-ink mb-2">Direct English &amp; Spanish Assistance</h3>
            <p class="text-sm text-ink-secondary leading-relaxed">
              Full bilingual support from booking through return. Call us in English or Español —
              our local team answers directly, no transfer, no queue.
            </p>
          </div>

          <!-- Value card 3 — Three Airports -->
          <div class="bg-white rounded-2xl p-8 border border-border hover:border-brand-200 transition-colors">
            <svg class="w-8 h-8 text-accent mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            <h3 class="text-lg font-semibold text-ink mb-2">Service at MIA, FLL &amp; PBI</h3>
            <p class="text-sm text-ink-secondary leading-relaxed">
              Contactless pickup from designated parking facilities at all three South Florida airports.
              Free delivery to MIA and FLL. Paid delivery to Palm Beach.
            </p>
          </div>

          <!-- Value card 4 — Exact Vehicle -->
          <div class="bg-white rounded-2xl p-8 border border-border hover:border-brand-200 transition-colors">
            <svg class="w-8 h-8 text-accent mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l3 3m0 0l3-3m-3 3v-7.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="text-lg font-semibold text-ink mb-2">Exact Vehicle, Guaranteed</h3>
            <p class="text-sm text-ink-secondary leading-relaxed">
              The vehicle shown in your reservation details is the vehicle you receive.
              No "or similar" substitutions. What you see is what you drive — every time.
            </p>
          </div>

          <!-- Value card 5 — Professional Maintenance -->
          <div class="bg-white rounded-2xl p-8 border border-border hover:border-brand-200 transition-colors">
            <svg class="w-8 h-8 text-accent mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.384 3.174.286-6.06L4.066 8.476l6.08-.82L12 2.13l2.854 5.564 6.08.82-4.272 3.808.286 6.06-5.384-3.174z" />
            </svg>
            <h3 class="text-lg font-semibold text-ink mb-2">Professionally Prepared &amp; Maintained</h3>
            <p class="text-sm text-ink-secondary leading-relaxed">
              Every vehicle is cleaned, inspected, and professionally prepared before each rental.
              We maintain our own fleet so quality stays consistent across every trip.
            </p>
          </div>

          <!-- Value card 6 — Contactless Pickup -->
          <div class="bg-white rounded-2xl p-8 border border-border hover:border-brand-200 transition-colors">
            <svg class="w-8 h-8 text-accent mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8zM4.054 14.37A5.994 5.994 0 011.5 12.75V12a6 6 0 011.995-4.36m6.344-2.038A14.926 14.926 0 0121 12.75m-5.41 1.62A14.926 14.926 0 009.631 8" />
            </svg>
            <h3 class="text-lg font-semibold text-ink mb-2">Contactless Airport Pickup</h3>
            <p class="text-sm text-ink-secondary leading-relaxed">
              Walk up to your car. Receive private location instructions directly via text.
              No counter lines, no paperwork, no waiting. Get in and go.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ CONTACT CTA BAND ═══════════════════ -->
    <section class="section bg-gradient-to-r from-brand-900 to-brand-700 text-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">Questions? Reach us directly.</h2>
        <p class="text-lg text-white/70 max-w-xl mx-auto mb-6">
          Our local team speaks English and Spanish. Call, text, or WhatsApp — no bots, no wait times.
        </p>
        <p class="text-3xl font-bold text-white mb-8">
          <a href={`tel:${SITE.phoneTel}`} class="hover:text-accent transition-colors">{SITE.phoneDisplay}</a>
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="/vehicles/" class="btn btn-light btn-primary-lg">Choose Your Vehicle</a>
          <a href="/contact/" class="btn px-8 py-4 text-base font-semibold text-white border-2 border-white/30 rounded-lg hover:bg-white/10 transition-all">Contact Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</BaseLayout>

<style>
  /* Ensure brand colors in gradient */
  .bg-gradient-to-r.from-brand-900.to-brand-700 {
    background: linear-gradient(135deg, var(--color-brand-900), var(--color-brand-700));
  }
</style>
