---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/base/Header.astro";
import Footer from "../../components/base/Footer.astro";
import VehicleGallery from "../../components/ui/VehicleGallery.astro";
import vehicles from "../../data/vehicles.json";
import { getFuelLabel } from "../../config/labels";
import { SITE } from "../../config/site";

const phoneTel = SITE.phoneTel;

export async function getStaticPaths() {
  return vehicles
    .filter(v => v.publication_status === "preview_only" || v.publication_status === "published")
    .map(v => ({ params: { slug: v.slug }, props: { vehicle: v } }));
}

const { vehicle } = Astro.props;

const seatsLabel = Number(vehicle.passenger_capacity) === 1 ? "seat" : "seats";
const luggageLabel = Number(vehicle.luggage_large) || Number(vehicle.luggage_small) || 0;
const carryonLabel = Number(vehicle.luggage_carryon) || 0;

const bestFor = (vehicle.best_for_en && vehicle.best_for_en.length > 0)
  ? vehicle.best_for_en
  : ["Airport travel"];

const relatedVehicles = vehicles
  .filter(v => v.slug !== vehicle.slug && (v.publication_status === "preview_only" || v.publication_status === "published"))
  .slice(0, 3);

const hasGallery = vehicle.gallery && vehicle.gallery.length > 0;
const hasFeatures = vehicle.key_features && vehicle.key_features.length > 0;
---

<BaseLayout
  title={vehicle.name}
  description={`${vehicle.tagline_en} — ${vehicle.name}. ${vehicle.passenger_capacity} ${seatsLabel}, ${getFuelLabel(vehicle.fuel_type, "en")}. Direct rental with free airport delivery at MIA and FLL.`}
>
  <Header />

  <main id="main-content" class="flex-1">
    {/* Hero */}
    <section class="relative bg-brand-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
          {/* Primary Hero Image */}
          <div class="relative">
            {vehicle.hero_image ? (
              <img
                src={vehicle.hero_image}
                alt={vehicle.name}
                class="w-full aspect-[16/10] object-cover rounded-2xl shadow-xl"
                loading="eager"
                width="800" height="500"
              />
            ) : (
              <div class="w-full aspect-[16/10] bg-brand-800/50 rounded-2xl flex items-center justify-center text-white/30">Photo pending</div>
            )}
          </div>

          {/* Hero content */}
          <div class="text-white">
            <p class="text-accent font-semibold tracking-[0.12em] uppercase text-sm mb-3">{vehicle.year} &middot; {vehicle.make}</p>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">{vehicle.name}</h1>
            <p class="mt-3 text-lg text-white/70 leading-relaxed">{vehicle.tagline_en}</p>

            {/* Key specs pills — year/make confirmed; passenger, luggage, fuel type are from verified inventory */}
            <div class="mt-6 flex flex-wrap gap-3">
              <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/10 text-sm">
                &#128103; {vehicle.passenger_capacity} {vehicle.passenger_capacity === 1 ? "seat" : "seats"}
              </span>
              <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/10 text-sm">
                &#128718; {luggageLabel} large luggage{carryonLabel > 0 ? ` + ${carryonLabel} carry-on` : ""}
              </span>
              <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/10 text-sm">
                {getFuelLabel(vehicle.fuel_type, "en")}
              </span>
            </div>

            {/* CTAs — Check Availability + separate Call / Text buttons */}
            <div class="mt-8 flex flex-col sm:flex-row gap-3">
              <a href={`/reserve/${vehicle.slug}/`} class="btn btn-light btn-primary-lg">Check availability &amp; pricing</a>
              <a href={`tel:${phoneTel}`} class="btn px-6 py-4 text-base font-semibold text-white border-2 border-accent text-accent rounded-lg hover:bg-accent hover:text-white transition-all">
                &#128222; Call Us
              </a>
              <a href={`sms:${phoneTel}`} class="btn px-6 py-4 text-base font-semibold text-white border-2 border-accent text-accent rounded-lg hover:bg-accent hover:text-white transition-all">
                &#128172; Text Us
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Description */}
    <section class="section bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <p class="text-lg text-ink-secondary leading-relaxed">{vehicle.description_en}</p>
      </div>
    </section>

    {/* Key Features — only if verified data exists; hidden entirely when none available */}
    {hasFeatures && (
      <section class="section bg-surface">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <p class="section-eyebrow">Features</p>
          <h2 class="section-title mb-8">Key Features</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {vehicle.key_features.map((feature: string) => (
              <div class="rounded-xl bg-white p-5 border border-border flex items-start gap-3">
                <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span class="text-ink-secondary text-sm">{feature}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Full Gallery Carousel */}
    {hasGallery && (
      <section class="section bg-white">
        <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
          <p class="section-eyebrow">Gallery</p>
          <h2 class="section-title">This Exact Vehicle</h2>
          <VehicleGallery images={vehicle.gallery} vehicleName={vehicle.name} />
        </div>
      </section>
    )}

    {/* Specs — only verified fields; trim/drivetrain removed until verified */}
    <section class="section bg-brand-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="section-eyebrow">Specifications</p>
        <h2 class="section-title mb-8">Details</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
          {[
            { label: "Year", value: vehicle.year },
            { label: "Make", value: vehicle.make },
            { label: "Model", value: vehicle.model },
            { label: "Seats", value: vehicle.passenger_capacity },
            { label: "Fuel", value: getFuelLabel(vehicle.fuel_type, "en") },
          ].filter(s => s.value).map(spec => (
            <div class="bg-white rounded-xl p-6 text-center">
              <p class="text-2xl font-bold text-ink">{spec.value}</p>
              <p class="text-xs text-ink-tertiary uppercase tracking-wider mt-1">{spec.label}</p>
            </div>
          ))}
        </div>
        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-white rounded-xl p-6 text-center border border-border">
            <p class="text-3xl font-bold text-ink">{vehicle.passenger_capacity}</p>
            <p class="text-xs text-ink-tertiary uppercase tracking-wider mt-1">Passengers</p>
            <p class="text-sm text-ink-secondary mt-1">Including driver</p>
          </div>
          <div class="bg-white rounded-xl p-6 text-center border border-border">
            <p class="text-3xl font-bold text-ink">{vehicle.luggage_large}</p>
            <p class="text-xs text-ink-tertiary uppercase tracking-wider mt-1">Large Luggage</p>
            {carryonLabel > 0 && <p class="text-sm text-ink-secondary mt-1">{carryonLabel} carry-on bags included</p>}
          </div>
        </div>
      </div>
    </section>

    {/* Fuel note — informational, not prescriptive */}
    <section class="section bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <p class="section-eyebrow">Powertrain</p>
        <h2 class="section-title mb-6">Fuel Type</h2>
        <div class="rounded-xl border border-border p-5 bg-surface-light">
          <p class="text-ink-secondary text-sm leading-relaxed">
            This is a <strong>{getFuelLabel(vehicle.fuel_type, "en")}</strong> vehicle.
            See our <a href="/rental-policies/" class="text-brand underline hover:text-accent">fuel policy</a>
            and <a href="/rental-requirements/" class="text-brand underline hover:text-accent">rental requirements</a> for charging and fuel-return details.
          </p>
        </div>
      </div>
    </section>

    {/* Airport Delivery */}
    <section class="section bg-brand-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="section-eyebrow">Service Area</p>
        <h2 class="section-title mb-8 text-center">Airport Delivery</h2>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          {[
            { code: "MIA", name: "Miami International", status: "Free delivery included" },
            { code: "FLL", name: "Fort Lauderdale\u2013Hollywood", status: "Free delivery included" },
            { code: "PBI", name: "Palm Beach International", status: "Paid delivery available" },
          ].map(airport => (
            <div class="bg-white rounded-xl p-8 text-center border border-border group">
              <div class="text-3xl font-bold text-accent mb-2">{airport.code}</div>
              <p class="text-sm text-ink-secondary">{airport.name}</p>
              <div class="mt-4 inline-block px-4 py-2 rounded-full bg-brand-50">
                <span class="text-sm font-semibold text-brand">{airport.status}</span>
              </div>
              <p class="mt-3 text-xs text-ink-secondary">Contactless handoff from designated parking. Exact location sent privately after booking.</p>
            </div>
          ))}
        </div>

        {/* Airport parking disclosure — calm, clear */}
        <div class="mt-8 flex items-start gap-3 rounded-xl bg-surface-light border border-border p-5">
          <svg class="w-5 h-5 text-brand mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <div>
            <p class="font-medium text-ink text-sm">Airport Parking Charges Apply</p>
            <p class="text-sm text-ink-secondary mt-1">The renter is responsible for any airport parking fees charged by the facility while the vehicle is parked on-site. These charges are disclosed in your rental agreement and confirmed during booking.</p>
          </div>
        </div>
      </div>
    </section>

    {/* Booking Requirements Summary */}
    <section class="section bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="section-eyebrow">Your Rental</p>
        <h2 class="section-title mb-8 text-center">Booking Requirements</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="rounded-xl bg-brand-50 p-6 text-center border border-border">
            <svg class="w-7 h-7 text-brand mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-1.5 4.5H4.5m15 0v-1.5a3 3 0 00-3-3h-.759a3.09 3.09 0 01-2.155-.965l-.73-.73a3.09 3.09 0 00-2.156-.965H6.75a3 3 0 00-3 3v1.5m15-1.5H6.75"/></svg>
            <p class="font-semibold text-ink text-sm">Refundable Deposit</p>
            <p class="text-xs text-ink-secondary mt-1">Amount varies by vehicle. Authorized at pickup, released after inspection.</p>
            <a href="/rental-requirements/" class="inline-block mt-3 text-xs font-medium text-brand hover:text-accent transition-colors">Learn more &rarr;</a>
          </div>
          <div class="rounded-xl bg-brand-50 p-6 text-center border border-border">
            <svg class="w-7 h-7 text-brand mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.5V10.5m0 0V7.5m0 3h18m-18 7.5V16.5m0 0V13.5m18 0V7.5m0 3v3m0 0h-3m3-3h-3m-6.5 0V7.5m0 3v3m0 0h-3m3 0h3"/></svg>
            <p class="font-semibold text-ink text-sm">Mileage Allowance</p>
            <p class="text-xs text-ink-secondary mt-1">Daily mileage included. Overage rates apply beyond allowance.</p>
            <a href="/rental-policies/" class="inline-block mt-3 text-xs font-medium text-brand hover:text-accent transition-colors">View policies &rarr;</a>
          </div>
          <div class="rounded-xl bg-brand-50 p-6 text-center border border-border">
            <svg class="w-7 h-7 text-brand mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
            <p class="font-semibold text-ink text-sm">Insurance Options</p>
            <p class="text-xs text-ink-secondary mt-1">Choose coverage during booking — personal policy, credit card plan, or purchased coverage.</p>
            <a href="/rental-requirements/" class="inline-block mt-3 text-xs font-medium text-brand hover:text-accent transition-colors">Requirements &rarr;</a>
          </div>
          <div class="rounded-xl bg-brand-50 p-6 text-center border border-border">
            <svg class="w-7 h-7 text-brand mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.665 0-5.187-.57-7.499-1.632z"/></svg>
            <p class="font-semibold text-ink text-sm">Age Requirement</p>
            <p class="text-xs text-ink-secondary mt-1">Minimum age 21. Some vehicles require 25+. Confirmed at booking.</p>
            <a href="/rental-requirements/" class="inline-block mt-3 text-xs font-medium text-brand hover:text-accent transition-colors">Details &rarr;</a>
          </div>
        </div>
        <p class="mt-6 text-center text-sm text-ink-secondary">Tolls: E-zpass/toll transponder available upon request. Toll charges billed separately based on actual usage.</p>
      </div>
    </section>

    {/* Related Vehicles */}
    {relatedVehicles.length > 0 && (
      <section class="section bg-brand-50">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <p class="section-eyebrow">Also Consider</p>
          <h2 class="section-title mb-8 text-center">Related Vehicles</h2>
          <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {relatedVehicles.map(rv => (
              <a href={`/vehicles/${rv.slug}/`} class="card group">
                <div class="aspect-[16/10] bg-brand-100 overflow-hidden">
                  {rv.hero_image ? (
                    <img src={rv.hero_image} alt={rv.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" loading="lazy" width="600" height="375" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-ink-tertiary text-sm">Photo pending</div>
                  )}
                </div>
                <div class="p-5">
                  <h3 class="font-semibold text-ink group-hover:text-brand transition-colors">{rv.name}</h3>
                  <div class="mt-2 flex gap-2"><span class="chip text-xs">{rv.passenger_capacity} seats</span><span class="chip text-xs">{getFuelLabel(rv.fuel_type, "en")}</span></div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Final CTA */}
    <section class="section gradient-brand text-white text-center">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-4xl font-bold tracking-tight">Ready to drive the {vehicle.name}?</h2>
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href={`/reserve/${vehicle.slug}/`} class="btn btn-light btn-primary-lg">Check availability &amp; pricing</a>
          <div class="flex gap-3">
            <a href={`tel:${phoneTel}`} class="btn px-5 py-4 text-sm font-semibold text-white border-2 border-accent text-accent rounded-lg hover:bg-accent hover:text-white transition-all">
              &#128222; Call Us
            </a>
            <a href={`sms:${phoneTel}`} class="btn px-5 py-4 text-sm font-semibold text-white border-2 border-accent text-accent rounded-lg hover:bg-accent hover:text-white transition-all">
              &#128172; Text Us
            </a>
          </div>
        </div>
        <p class="mt-3 text-sm text-white/50">English &amp; Spanish support \u2022 WhatsApp available</p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
