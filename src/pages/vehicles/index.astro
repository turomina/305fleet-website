---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/base/Header.astro";
import Footer from "../../components/base/Footer.astro";
import vehicles from "../../data/vehicles.json";
import { getFuelLabel } from "../../config/labels";

const allVehicles = vehicles.filter(v => v.publication_status === "preview_only" || v.publication_status === "published");
---

<BaseLayout
  title="Our Fleet"
  description="Browse the 305 Fleet catalog — newer, well-maintained vehicles for direct rental in South Florida. Free airport delivery at MIA and FLL."
>
  <Header />

  <main id="main-content" class="flex-1">
    <!-- Hero -->
    <section class="section-sm gradient-dark text-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="text-accent font-semibold tracking-[0.12em] uppercase text-sm mb-4">Fleet Catalog</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight">{allVehicles.length} vehicles. One standard.</h1>
        <p class="mt-4 text-lg text-white/70 max-w-2xl">
          Every vehicle is newer, well-maintained, and professionally presented.
          Free airport delivery at MIA and FLL. Paid delivery to PBI.
        </p>
      </div>
    </section>

    <!-- Fleet Grid -->
    <section class="section bg-surface">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        {allVehicles.length === 0 ? (
          <div class="text-center py-16">
            <p class="text-xl text-ink-secondary">No vehicles available. Check back soon.</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {allVehicles.map(v => {
              const imgBase = v.hero_image ? v.hero_image.replace(/\.[^.]+$/, '') : null;
              return (
              <div class="group flex flex-col rounded-2xl border border-border bg-white shadow-sm transition-all duration-300 hover:border-navy-300 hover:shadow-lg">
                <a href={`/vehicles/${v.slug}/`} class="block overflow-hidden rounded-t-2xl">
                  <div class="aspect-[4/3] bg-surface-light">
                    {v.hero_image ? (
                      <picture>
                        <source
                          type="image/avif"
                          srcset={`${imgBase}-400w.avif 400w, ${imgBase}-600w.avif 600w, ${imgBase}-800w.avif 800w, ${imgBase}-1200w.avif 1200w, ${imgBase}-1600w.avif 1600w`}
                          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                        />
                        <source
                          type="image/webp"
                          srcset={`${imgBase}-400w.webp 400w, ${imgBase}-600w.webp 600w, ${imgBase}-800w.webp 800w, ${imgBase}-1200w.webp 1200w, ${imgBase}-1600w.webp 1600w`}
                          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                        />
                        <img src={v.hero_image} alt={`${v.name} — exterior photo`} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" decoding="async" width="600" height="450" />
                      </picture>
                    ) : (
                      <div class="flex h-full w-full items-center justify-center">
                        <p class="text-sm text-ink-tertiary">Photo pending</p>
                      </div>
                    )}
                  </div>
                </a>
                <div class="flex flex-1 flex-col gap-2 p-5">
                  <a href={`/vehicles/${v.slug}/`} class="block">
                    <h2 class="text-lg font-semibold leading-tight text-navy-900 transition-colors group-hover:text-blue-500">{v.name}</h2>
                    <p class="text-sm text-ink-secondary line-clamp-1">{v.tagline_en}</p>
                  </a>
                  <dl class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
                    <dt class="sr-only">Passenger capacity</dt>
                    <dd class="flex items-center gap-1.5 text-ink-secondary">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
                      <span>{v.passenger_capacity} seats</span>
                    </dd>
                    <dt class="sr-only">Luggage capacity</dt>
                    <dd class="flex items-center gap-1.5 text-ink-secondary">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 00-7.5 0l-4.5 1.5a3 3 0 000 5.714l4.5 1.5a3.75 3.75 0 007.5 0l4.5-1.5a3 3 0 000-5.714l-4.5-1.5a3.75 3.75 0 00-7.5 0z" /></svg>
                      <span>{v.luggage_large} bag(s)</span>
                    </dd>
                    <dt class="sr-only">Fuel type</dt>
                    <dd class={`flex items-center gap-1.5 ${(v.fuel_type==="electric")?"text-emerald-600":(v.fuel_type==="plug_in_hybrid"||v.fuel_type==="hybrid")?"text-orange-500":"text-gray-400"}`}>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003.361 6.867zM15.362 5.214L18 9.6m-2.638-4.386L12 21" /></svg>
                      <span>{getFuelLabel(v.fuel_type, "en")}</span>
                    </dd>
                  </dl>
                  {v.publication_status === "preview_only" && (
                    <span class="inline-block w-fit rounded-full bg-warning/[.12] px-2.5 py-0.5 text-xs font-medium text-warning">Preview</span>
                  )}
                  <div class="mt-auto pt-3">
                    <a href={`/reserve/${v.slug}/`} class="mb-2 block w-full rounded-xl bg-brand px-4 py-2.5 text-center text-sm font-semibold text-white shadow-[0_2px_8px_-2px_rgba(49,75,110,.3)] transition-all duration-300 hover:bg-brand-400 hover:-translate-y-0.5 hover:shadow-[0_6px_20px_-4px_rgba(49,75,110,.35)]">
                      Check availability &amp; pricing
                    </a>
                    <a href={`/vehicles/${v.slug}/`} class="block text-center text-sm font-medium text-blue-500 underline-offset-2 transition-colors group-hover:underline">
                      View vehicle details &rarr;
                    </a>
                  </div>
                </div>
              </div>
              );
            })}
          </div>
        )}
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="section-sm bg-brand-50">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-ink">Not sure which vehicle?</h2>
        <p class="mt-3 text-ink">Our team can help you find the right vehicle for your trip.</p>
        <div class="mt-6">
          <a href="/contact/" class="btn btn-primary">Contact Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>