---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/base/Header.astro";
import Footer from "../components/base/Footer.astro";
import { SITE } from "../config/site";

const phoneDisplay = SITE.phoneDisplay;
const phoneTel = SITE.phoneTel;
const whatsappNumber = SITE.whatsapp;
const email = SITE.email;
---

<BaseLayout
  title="Support"
  description="305 Fleet customer support — get help during your rental, request extensions, or report an issue."
>
  <Header />

  <main id="main-content" class="flex-1 bg-white">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <h1 class="text-3xl font-bold text-gray-900">Need Help with Your Rental?</h1>
      <p class="mt-3 text-lg text-gray-600">
        Need help with your rental? Our team is available to assist with pickup instructions, vehicle questions, extensions, returns, and general rental support.
      </p>

      <div class="mt-8 rounded-2xl bg-brand-50 p-6 md:p-8">
        <h2 class="text-xl font-bold text-ink mb-4">Contact 305Fleet</h2>
        
        <div class="flex items-center gap-2 mb-6">
          <p class="text-2xl font-bold text-brand">
            <a href={`tel:${phoneTel}`} class="hover:text-accent transition-colors">{phoneDisplay}</a>
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 mb-6">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.148-.669-1.611-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347" /></svg>
            <span class="text-sm font-medium text-ink-secondary">WhatsApp Available</span>
          </div>
          <span class="text-ink-secondary">•</span>
          <span class="text-sm font-medium text-ink-secondary">English & Spanish</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href={`tel:${phoneTel}`} class="contact-btn contact-btn-primary">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <span>Call Now</span>
          </a>
          
          <a href={`sms:${phoneTel}`} class="contact-btn contact-btn-secondary">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
            <span>Text Us</span>
          </a>
          
          <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="contact-btn contact-btn-whatsapp">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.148-.669-1.611-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z" /></svg>
            <span>WhatsApp</span>
          </a>
          
          <a href={`mailto:${email}`} class="contact-btn contact-btn-email">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            <span>Email</span>
          </a>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900">During Your Rental</h2>
          <p class="mt-2 text-sm text-gray-600">
            Vehicle issues, roadside assistance, questions about your vehicle, or need an extension?
            Contact us immediately.
          </p>
        </div>

        <div class="rounded-xl border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900">Before You Book</h2>
          <p class="mt-2 text-sm text-gray-600">
            Questions about vehicle availability, pricing, requirements, or policies?
            Check our FAQ or contact us.
          </p>
          <div class="mt-4">
            <a href="/faq/" class="inline-flex items-center text-sm font-medium text-brand hover:underline">
              View FAQ →
            </a>
          </div>
        </div>

        <div class="rounded-xl border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900">Roadside Assistance</h2>
          <p class="mt-2 text-sm text-gray-600">
            If you experience a vehicle issue during your rental, contact us immediately.
            Roadside assistance details are provided in your rental agreement.
          </p>
        </div>

        <div class="rounded-xl border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-gray-900">Extensions & Returns</h2>
          <p class="mt-2 text-sm text-gray-600">
            Need to extend your rental or adjust your return time? Contact us as soon as possible.
            Extensions are subject to availability and additional charges.
          </p>
          <a href="/rental-policies/" class="mt-3 inline-flex items-center text-sm font-medium text-brand hover:underline">
            View Policies →
          </a>
        </div>
      </div>

      <div class="mt-8 rounded-lg bg-yellow-50 border border-yellow-300 p-4">
        <p class="text-sm text-yellow-900">
          ⚠️ For emergencies, dial 911 first. For vehicle-related issues, contact us after ensuring
          your safety.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .contact-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    font-weight: 600;
    font-size: 1rem;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: all 0.2s ease;
    min-height: 56px;
    cursor: pointer;
    border: 2px solid transparent;
  }

  .contact-btn-primary {
    background: var(--color-brand);
    color: white;
  }
  .contact-btn-primary:hover {
    background: var(--color-brand-400);
    transform: translateY(-2px);
    box-shadow: 0 8px 16px -4px rgba(49, 75, 110, 0.3);
  }

  .contact-btn-secondary {
    background: white;
    color: var(--color-brand);
    border-color: var(--color-brand);
  }
  .contact-btn-secondary:hover {
    background: var(--color-brand-50);
    transform: translateY(-2px);
  }

  .contact-btn-whatsapp {
    background: white;
    color: var(--color-brand);
    border-color: var(--color-brand);
  }
  .contact-btn-whatsapp:hover {
    background: var(--color-brand-50);
    transform: translateY(-2px);
  }
  .contact-btn-whatsapp svg {
    color: #25D366;
  }

  .contact-btn-email {
    background: white;
    color: var(--color-brand);
    border-color: var(--color-brand);
  }
  .contact-btn-email:hover {
    background: var(--color-brand-50);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .contact-btn {
      padding: 1rem 1.25rem;
      font-size: 0.9375rem;
    }
  }
</style>
